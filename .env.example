# ==================================================
# COURSE AUDITOR CONFIGURATION (.env.example)
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to Git!
# ==================================================

# Required URLs
COURSE_URL=
SOURCE_URL=

# Optional Course Name (auto-detected if left blank)
COURSE_NAME=

# Optional Google Docs Configuration
GOOGLE_DOC_ID=
GOOGLE_CREDENTIALS_PATH=./credentials/google-credentials.json
GOOGLE_TOKEN_PATH=./credentials/google-token.json

# Crawler & Browser Options
HEADLESS=false
SLOW_MO=50
NAVIGATION_TIMEOUT_MS=45000
SLIDE_WAIT_MS=1500
MAX_SOURCE_PAGES=200
RESUME_ENABLED=true

# Incremental / Single-item test mode (true = 1 module, 1 subtopic, 1 slide)
SINGLE_TEST_MODE=false
